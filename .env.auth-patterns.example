# ── Authentication Patterns — four agents, same "HI - Cross-App Access (Login as agent)" chain ──
#   T0 /authorize → T1 /token (code → id_token) → T2 id-JAG → T3 resource token → T4 MCP
#   The agent's own client authentication is used at T1, T2 and T3.
# A pattern with a blank CLIENT_ID shows as "Not configured" on its card.

# ── Shared (blank = falls back to .env) ──
AUTH_PATTERNS_ISSUER=                 # login AS for T0/T1 → OKTA_ISSUER
AUTH_PATTERNS_SCOPES=openid profile email
AUTH_PATTERNS_AGENT_AUTH_SERVER=      # T2 token-exchange → AGENT_AUTH_SERVER
AUTH_PATTERNS_AUDIENCE=               # T2 audience → RESOURCE_AUDIENCE / RESOURCE_AUTH_SERVER
AUTH_PATTERNS_IDJAG_SCOPES=inventory:read
AUTH_PATTERNS_RESOURCE=
# Redirect URIs default to <APP_BASE_URL>/api/authp/<pkjwt|secret|public|cimd>/callback
# — register the matching one on each Okta app, or override with <PATTERN>_AGENT_REDIRECT_URI.

# ── 1) Public / Private key (private_key_jwt) ──
PKJWT_AGENT_CLIENT_ID=
# PKJWT_AGENT_PRIVATE_KEY_FILE=./keys/agent.pem   # defaults to AGENT_PRIVATE_KEY_FILE
# PKJWT_AGENT_KID=                                # defaults to AGENT_KID

# ── 2) Client ID / Client secret ──
SECRET_AGENT_CLIENT_ID=
SECRET_AGENT_CLIENT_SECRET=
SECRET_AGENT_TOKEN_AUTH_METHOD=client_secret_basic   # or client_secret_post

# ── 3) Client ID only (public client: auth method "None" + Require PKCE) ──
PUBLIC_AGENT_CLIENT_ID=

# ── 4) CIMD — the client_id IS the metadata document URL this app serves ──
#   <APP_BASE_URL>/api/authp/cimd/client-metadata.json   (keys at /api/authp/cimd/jwks.json)
#   Okta must be able to fetch it, so it must be a public HTTPS URL; localhost won't work.
CIMD_AGENT_CLIENT_ID=https://o4aa-agent-flows.onrender.com/api/authp/cimd/client-metadata.json
CIMD_AGENT_CLIENT_NAME=O4AA CIMD Agent
CIMD_AGENT_TOKEN_AUTH_METHOD=private_key_jwt         # or none
# CIMD_AGENT_PRIVATE_KEY_FILE=./keys/agent.pem       # defaults to AGENT_PRIVATE_KEY_FILE
# CIMD_AGENT_KID=                                    # defaults to the key's JWK thumbprint
