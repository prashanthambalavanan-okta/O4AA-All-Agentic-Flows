# ─────────────────────────────────────────────────────────────
# Okta Cross-App Access (XAA) Inventory Demo — environment config
# Copy to .env and fill in your real Okta values. Real Okta only.
# ─────────────────────────────────────────────────────────────

PORT=8080
# Where the browser reaches the app (used to build the OIDC redirect URI / final redirect)
APP_BASE_URL=http://localhost:8080
SESSION_SECRET=change-me-to-a-long-random-string

# ── T1 · User login (Chat app — OIDC web app, public/private key) ──
# The web app authenticates at /token with private_key_jwt — there is NO client secret.
# In Okta: General → Client Credentials → Client authentication = "Public key / Private key",
# then add the SAME public JWK you registered on the agent app (node scripts/agent-key.mjs).
OKTA_ISSUER=https://your-org.okta.com/oauth2/your-auth-server-id
OKTA_CLIENT_ID=
OKTA_REDIRECT_URI=http://localhost:8080/api/callback
OKTA_SCOPES=openid profile email
# The login app signs with the same key as the agent, so there is only ever ONE keypair
# to manage. Set these only if you deliberately want a separate key for the web app;
# otherwise they default to AGENT_PRIVATE_KEY_FILE / AGENT_KID below.
# OKTA_PRIVATE_KEY_FILE=./keys/agent.pem
# OKTA_KID=
# Escape hatch: set to client_secret_basic or client_secret_post (and fill
# OKTA_CLIENT_SECRET) if the Okta app hasn't been switched to key auth yet.
# OKTA_TOKEN_AUTH_METHOD=private_key_jwt
# OKTA_CLIENT_SECRET=

# HI - Cross-App Access (Login as Web App) — a separate confidential web app
# (client_secret auth, not private_key_jwt) whose /authorize call is the T1 login
# for the 'xaa-webapp' flow. Its ACCESS token (not id_token) becomes the T2
# token-exchange subject, then reuses the same agent/resource id-JAG chain as 'xaa'.

# Client ID of the separate "Web App" OIDC application in Okta (Authorization Code,
# client_secret_basic). Must be a different app registration than OKTA_CLIENT_ID.
WEBAPP_CLIENT_ID=<the web app's client ID>

# Client secret for the Web App application above — used for client_secret_basic
# auth at its /token endpoint (this is what distinguishes this flow from the
# private_key_jwt agent flow).
WEBAPP_CLIENT_SECRET=<the web app's client secret>

# Redirect URI registered on the Web App application; must exactly match what's
# configured in Okta. Locally this is the Express server's own callback route.
WEBAPP_REDIRECT_URI=http://localhost:8080/api/webapp/callback

# RFC 8707 'resource' parameter sent on this app's own /authorize call — the
# resource indicator identifying which downstream API/resource server the web
# app's access token is meant for. Leave unset to omit the param entirely.
WEBAPP_RESOURCE=<the resource indicator for its /authorize call>
Optional (only needed if this app differs from the defaults baked into server/config.js):


# Issuer for the Web App application, if it lives in a different Okta org/auth
# server than the main OKTA_ISSUER. Defaults to OKTA_ISSUER when unset.
WEBAPP_ISSUER=<issuer URL, if different from OKTA_ISSUER>

# Space-delimited scopes requested on the Web App's /authorize call.
# Defaults to "openid profile email".
WEBAPP_SCOPES=openid profile email

# Token endpoint auth method for the Web App client. Defaults to
# "client_secret_basic"; set to "client_secret_post" if your Okta app expects
# the secret in the POST body instead of the Authorization header.
WEBAPP_TOKEN_AUTH_METHOD=client_secret_basic

# ── T2 · Agent app → id-JAG (token-exchange, private_key_jwt) ──
# Agent's authorization server URL. The /v1/token endpoint is derived from it.
# Leave blank to reuse OKTA_ISSUER (same authorization server as user login).
AGENT_AUTH_SERVER=https://your-org.okta.com/oauth2/agent-auth-server-id
AGENT_CLIENT_ID=
# PEM-encoded RSA private key. The matching public JWK must be registered on the agent
# client in Okta — and on the login web app(s) above, which reuse this same key.
AGENT_PRIVATE_KEY_FILE=./keys/agent.pem
# kid of the registered public key (must match the JWK 'kid' in Okta)
AGENT_KID=
# Optional resource URI indicator (omitted from the request if blank).
XAA_RESOURCE=
XAA_SCOPES=inventory:read

# ── T3 · Resource client → access token (jwt-bearer, client_id only — no key/secret) ──
# Resource's authorization server URL. The /v1/token endpoint is derived from it.
# Also used as the T2 token-exchange 'audience' (the id-JAG's target).
RESOURCE_AUTH_SERVER=https://your-org.okta.com/oauth2/resource-auth-server-id
# Optional: override the T2 token-exchange 'audience' when Okta expects the resource
# authorization server's configured Audience value (Security > API > Authorization
# Servers > Settings) or its token endpoint instead of its issuer URL. Unset = use
# RESOURCE_AUTH_SERVER above.
#RESOURCE_AUDIENCE=
# T3 authenticates as AGENT_CLIENT_ID (which must match the id-JAG's client_id).
RESOURCE_SCOPES=inventory:read

# ── HI - SAML - Cross-App Access ──
# T1: user signs in via a SAML app (IdP-initiated). Okta POSTs the assertion to the
#     app's ACS. In your Okta SAML app, set the Single Sign-On URL / ACS URL to:
#         <APP_BASE_URL>/api/saml/acs
#     (e.g. https://o4aa-agent-flows.onrender.com/api/saml/acs). Sign the assertion.
# T2: SAML assertion → refresh_token (token-exchange, subject_token_type=saml2,
#     private_key_jwt with the AGENT cert; scope = openid offline_access).
# T3: refresh_token → id-JAG (audience = RESOURCE_AUTH_SERVER, scope = RESOURCE_SCOPES).
# T4/T5 reuse the Cross-App Access access-token + MCP steps.
#
# The Okta IdP-initiated SSO URL the tile sends the browser to (from the SAML app's
# "Embed Link" / IdP-initiated sign-on URL).
SAML_IDP_INITIATED_URL=https://your-org.okta.com/app/<app-name>/<app-id>/sso/saml
# T2/T3 token endpoint. Defaults to AGENT_AUTH_SERVER (same as Cross-App Access);
# override only if the SAML token-exchange runs at a different auth server.
# SAML_AUTH_SERVER=https://your-org.okta.com/oauth2/agent-auth-server-id

# ── Secrets flow (T2: vaulted-secret token exchange at the ORG token endpoint) ──
# The org base is derived from OKTA_ISSUER (or set OKTA_ORG_URL explicitly).
# OKTA_ORG_URL=https://your-org.okta.com
SECRETS_RESOURCE=orn:okta:pam:<tenant>:secrets:<secret-id>

# ── NHI · Secrets (Atlassian) flow: service client_credentials (SERVICE_* above) → vaulted
#    Atlassian client id/secret → Atlassian token → Jira Scrum board. No user login. ──
# ORN of the vaulted secret holding the Atlassian OAuth client id + client secret
# (two fields: client_id, client_secret — or username/password). Copy it from Okta PAM.
ATLASSIAN_SECRETS_RESOURCE=orn:okta:pam:<tenant>:secrets:<atlassian-secret-id>
ATLASSIAN_SCOPE=read:board-scope:jira-software read:issue-details:jira
# Type of the T1 service token used as the T2 subject (default: access_token)
# ATLASSIAN_SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token
ATLASSIAN_CLOUD_ID=<jira site cloud id>
ATLASSIAN_BOARD_ID=<scrum board id>
# ATLASSIAN_MAX_RESULTS=10

ATLASSIAN_TOKEN_SECRETS_RESOURCE=orn:okta:pam:<tenant>:secrets:<atlassian-token-secret-id>

# ── Service Account flow (T2: service-account token exchange at the ORG token endpoint) ──
SERVICE_ACCOUNT_RESOURCE=orn:okta:pam:<tenant>:apps:<app>:<id>:service_accounts:<sa-id>

# ── MCP HTTP Basic auth (T3 of Secrets / Service Account flows) ──
# The username/password the MCP validates the retrieved credentials against.
# Set these to match what your Okta secret / service account yields.
MCP_BASIC_USERNAME=
MCP_BASIC_PASSWORD=

# ── STS Broker flow (GitHub): token-exchange → brokered GitHub token → open PR ──
# Resource indicator from the Resource Connection config (like secrets/service account).
GITHUB_RESOURCE=
# Optional 'scope' on the STS token-exchange. NOTE: if the brokered token is a GitHub
# *App* token, GitHub uses App PERMISSIONS, not scopes — fix permissions in the App instead.
GITHUB_SCOPES=
# GitHub repo for T3 (read or create pull requests with the brokered token).
GITHUB_OWNER=
GITHUB_REPO=
# GITHUB_API_BASE_URL=https://api.github.com
# Used by the "Create a pull request" action (the head branch must exist with commits vs base):
GITHUB_PR_BASE=main
GITHUB_PR_HEAD=
GITHUB_PR_TITLE=Automated PR via Okta AI Agent
# GITHUB_PR_BODY=Opened by the AI agent using an Okta STS-brokered GitHub token.

# ── Agent-to-Agent (A2A) ──
# A2A config now lives in its own file: copy .env.a2a.example to .env.a2a.

# ── Service App flow (client_credentials → id-JAG → access token) ──
# A headless service identity (no user). It authenticates T1/T2/T3 with its own
# private_key_jwt cert; reuses RESOURCE_AUTH_SERVER / RESOURCE_AUDIENCE for the
# id-JAG target + T3, like Cross-App Access.
SERVICE_CLIENT_ID=
SERVICE_PRIVATE_KEY_FILE=./keys/service.pem
SERVICE_KID=
# Scope for the client_credentials request (T1). Optional — omitted if blank.
SERVICE_SCOPES=
# Scope for the T2 id-JAG token-exchange. Defaults to inventory:read; omitted if blank.
SERVICE_IDJAG_SCOPES=inventory:read
# Token type of the service token when used as subject_token at T2 (default: access_token).
# SERVICE_SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:access_token
# T1 ONLY — the auth server the service app gets its token from (client_credentials).
# Its /v1/token endpoint is derived from this. Defaults to AGENT_AUTH_SERVER if blank.
SERVICE_ISSUER=
# T1 ONLY — the 'audience' parameter included in the client_credentials request. Omitted if blank.
SERVICE_AUDIENCE=
# T1 ONLY — the 'resource' parameter included in the client_credentials request. Omitted if blank.
SERVICE_RESOURCE=
# (T2/T3 are unchanged: T2 token-exchange still uses SERVICE_AUTH_SERVER/AGENT_AUTH_SERVER and
#  RESOURCE_AUDIENCE; T3 still uses RESOURCE_AUTH_SERVER.)
# SERVICE_AUTH_SERVER=
